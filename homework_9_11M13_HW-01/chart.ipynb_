    "    orient='h',\n",
    "    width=0.9, \n",
    "    hue= 'type_client',\n",
    "    legend=True\n",
    ")\n",
    "\n",
    "# # # # Получаем медианы и квартили\n",
    "quartiles = df_box.groupby('type_client')['Age'].quantile([.25, .5, .75]).unstack()\n",
